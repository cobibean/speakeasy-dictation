{
  "name": "speakeasy",
  "productName": "Speakeasy",
  "version": "0.1.40",
  "description": "Hold-to-talk dictation that transcribes, optionally polishes, and pastes at your cursor.",
  "main": "dist/main/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "electron-store": "^11.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.5.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "44.2.0",
    "electron-builder": "^26.4.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "supabase": "2.111.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "fast-uri": "4.1.3",
    "conf": {
      "ajv": "8.20.0"
    },
    "ajv": {
      "fast-uri": "4.1.3"
    }
  },
  "scripts": {
    "dev": "npm run build:renderer && npm run build:main && electron .",
    "dev:watch": "concurrently -k \"npm:dev:main:watch\" \"npm:dev:renderer:watch\" \"npm:dev:electron:watch\"",
    "dev:main:watch": "tsc -p tsconfig.main.json -w",
    "dev:renderer:watch": "vite",
    "dev:electron:watch": "node scripts/dev-electron-watch.mjs",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "build:renderer": "npm run typecheck:renderer && vite build",
    "build:main": "tsc -p tsconfig.main.json && node scripts/generate-product-public-config.mjs"
  }
}
